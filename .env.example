# Solo desarrollo local. Copiar a .env; nunca subir .env a GitHub.
STORAGE_MODE=demo
# Para usar Azure localmente: STORAGE_MODE=azure y az login
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=documentos
# En Azure, generar y configurar una clave aleatoria de 64 caracteres hexadecimales.
FLASK_SECRET_KEY=
